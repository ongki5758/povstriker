---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
<section class="border-t border-gray-200 bg-white py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="mb-8 text-center text-2xl font-bold text-gray-800 md:text-3xl">Pertanyaan Umum</h2>
    <div class="space-y-4">
      {faqs.map((item) => (
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
          <button class="faq-btn flex w-full items-center justify-between px-6 py-4 text-left focus:outline-none">
            <span class="font-semibold text-gray-800">{item.q}</span>
            <svg class="h-5 w-5 text-gray-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="faq-content hidden px-6 pb-4 text-sm text-gray-500 md:text-base">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>
