---
interface Props { academy: { tag: string; title: string; desc: string }[] }
const { academy } = Astro.props;
---
<section id="academy" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex items-end justify-between">
      <div>
        <h2 class="mb-2 text-2xl font-bold text-gray-800 md:text-3xl">Akademi POV Strike</h2>
        <p class="text-sm text-gray-500 md:text-base">Panduan, tips, dan ide meracik umpan untuk hasil maksimal.</p>
      </div>
      <a href="#" class="hidden font-semibold text-[#1B4332] transition-colors hover:text-[#F77F00] md:inline-flex">Semua Artikel →</a>
    </div>
    <div class="hide-scroll -mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-6 lg:mx-0 lg:grid lg:grid-cols-4 lg:px-0 lg:pb-0">
      {academy.map((item) => (
        <div class="group w-[280px] shrink-0 snap-start overflow-hidden rounded-2xl border border-gray-200 bg-white transition-shadow hover:shadow-lg lg:w-auto">
          <div class="aspect-[16/10] overflow-hidden bg-gray-200">
            <img src="/images/water-texture.webp" alt={item.title} class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-5">
            <span class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-[#F77F00]">{item.tag}</span>
            <h3 class="mb-2 text-lg leading-tight font-bold text-gray-800 transition-colors group-hover:text-[#1B4332]">{item.title}</h3>
            <p class="mb-4 line-clamp-2 text-sm text-gray-500">{item.desc}</p>
            <a href="#" class="text-sm font-semibold text-[#1B4332] transition-colors hover:text-[#F77F00]">Baca Lanjut →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
