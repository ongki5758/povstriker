<section class="border-b border-gray-200 bg-[#F8F9FA] py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-4 text-2xl font-bold text-gray-800 md:text-3xl">Panduan Pemakaian Mudah</h2>
        <p class="mb-8 text-base text-gray-500">Mudah digunakan, bahkan untuk pemula. Siapkan umpan andalan Anda dalam hitungan menit.</p>
        <div class="space-y-6">
          {['Teteskan 3-5 tetes untuk 500g umpan.', 'Aduk hingga merata selama 1-2 menit.', 'Diamkan umpan selama 5 menit agar meresap.', 'Lempar umpan dan bersiap untuk strike.'].map((step, idx) => (
            <div class="flex gap-4"><div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#1B4332] font-bold text-white">{idx + 1}</div><p class="pt-1 font-medium text-gray-800">{step}</p></div>
          ))}
        </div>
        <div class="mt-10"><a href="#academy" class="inline-flex font-semibold text-[#1B4332] underline underline-offset-4 transition-colors hover:text-[#F77F00]">Baca Panduan Lengkap</a></div>
      </div>
      <div class="relative aspect-video overflow-hidden rounded-3xl border-4 border-white bg-gray-200 shadow-lg">
        <img src="/images/water-texture.webp" alt="Visual perairan untuk panduan pemakaian POV Strike" class="h-full w-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-[#1B4332]/35"></div>
        <div class="absolute inset-0 flex items-center justify-center"><div class="flex h-16 w-16 cursor-pointer items-center justify-center rounded-full bg-white/80 text-[#1B4332] backdrop-blur transition-transform hover:scale-110"><svg class="ml-1 h-8 w-8" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg></div></div>
      </div>
    </div>
  </div>
</section>
