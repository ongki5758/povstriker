---
interface Props {
  fishSpecies: {
    name: string;
    desc: string;
    highlight: string;
    image: string;
    alt: string;
  }[]
}
const { fishSpecies } = Astro.props;
---
<section id="fish-species" class="bg-[#F8F9FA] py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center md:mb-16">
      <h2 class="mb-4 text-2xl font-bold text-gray-800 md:text-3xl lg:text-4xl">Pilih Target Ikan Anda</h2>
      <p class="mx-auto max-w-2xl text-base text-gray-500">Temukan formula yang tepat berdasarkan ikan target pancingan Anda.</p>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
      {fishSpecies.map((item) => (
        <a href="#shop" class="group flex flex-col items-center rounded-2xl border border-gray-200 bg-white p-5 text-center shadow-sm transition-all duration-300 hover:border-[#1B4332]/30 hover:shadow-md">
          <div class="mb-4 h-20 w-20 overflow-hidden rounded-full border border-gray-200 bg-slate-100 shadow-sm ring-4 ring-white transition-transform group-hover:scale-110">
            <img src={item.image} alt={item.alt} class="h-full w-full object-cover" loading="lazy" width="80" height="80" />
          </div>
          <div class="mb-3 rounded-full bg-[#1B4332]/6 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-[#1B4332]">{item.highlight}</div>
          <h3 class="mb-2 text-lg font-bold text-gray-800">{item.name}</h3>
          <p class="mb-4 flex-grow text-xs text-gray-500">{item.desc}</p>
          <span class="text-sm font-semibold text-[#1B4332] transition-colors group-hover:text-[#F77F00]">Cek Formula</span>
        </a>
      ))}
    </div>
  </div>
</section>
