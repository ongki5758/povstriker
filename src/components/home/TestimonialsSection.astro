---
import StarRating from '../StarRating.astro';
interface Props { testimonials: { name: string; city: string; initial: string; quote: string }[] }
const { testimonials } = Astro.props;
---
<section id="reviews" class="bg-[#F8F9FA] py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="mb-2 text-2xl font-bold text-gray-800 md:text-3xl">Kata Pemancing</h2>
      <p class="text-base text-gray-500">Ulasan asli dari komunitas kami.</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {testimonials.map((item) => (
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <StarRating class="mb-4" />
          <p class="mb-6 italic text-gray-800">"{item.quote}"</p>
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-200 font-bold text-gray-500">{item.initial}</div>
            <div><h4 class="text-sm font-bold text-gray-800">{item.name}</h4><p class="text-xs text-gray-500">{item.city}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
